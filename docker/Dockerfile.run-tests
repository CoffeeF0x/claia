FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
  pulseaudio \
  libportaudio2 \
  alsa-utils \
  sox \
  libsox-fmt-all \
  espeak-ng \
  cmake \
  nano \
  sshpass \
  ffmpeg \
  python3-pil

# Install pytest and other testing dependencies
RUN pip install pytest pytest-cov --no-cache-dir

# Install additional dependencies for file processing
RUN pip install pydub moviepy PyPDF2 Pillow --no-cache-dir

COPY requirements.txt .
RUN pip install -r requirements.txt --no-cache-dir

COPY src/ src/
COPY modules/ modules/
COPY tests/ tests/

# Run tests instead of the main application
CMD ["pytest", "-xvs", "tests/"]