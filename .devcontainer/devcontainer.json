{
  "name": "Claia Development",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "runArgs": [
    "--name", "devcontainer-${localWorkspaceFolderBasename}",
    "--network", "exofox"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "shardulm94.trailing-spaces"
      ]
    }
  },

  "remoteUser": "root",
  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/init.sh",

  "mounts": [
    "source=C:/.cache/claia/models,target=${containerWorkspaceFolder}/models,type=bind,consistency=cached"
  ]
}