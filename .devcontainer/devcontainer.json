{
  "name": "Claia Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "mounts": [
    "source=C:/.cache/claia/models,target=${containerWorkspaceFolder}/models,type=bind,consistency=cached"
  ],
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && pip install -r requirements.txt",
  "remoteUser": "vscode"
}